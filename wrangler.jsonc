{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-11-17",
  // One public origin: no *.workers.dev or per-version URLs that skip the zone's HSTS and redirects.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // No request logs: the site promises no analytics, and logs would keep visitor IPs.
  "observability": {
    "enabled": false,
  },
}
